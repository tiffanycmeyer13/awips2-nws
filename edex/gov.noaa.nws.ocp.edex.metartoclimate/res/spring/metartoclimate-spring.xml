<beans xmlns="http://www.springframework.org/schema/beans"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd
  http://camel.apache.org/schema/spring http://camel.apache.org/schema/spring/camel-spring.xsd">

    <bean id="climateBloatMonitor"
        class="com.raytheon.uf.edex.database.health.DatabaseBloatMonitor">
        <constructor-arg>
            <bean class="com.raytheon.uf.edex.database.health.PostgresBloatDao">
                <constructor-arg ref="daoConfigFactory" />
                <constructor-arg value="climate" />
            </bean>
        </constructor-arg>
    </bean>
    
    <bean factory-bean="dbMonitorRegistry" factory-method="registerMonitor">
        <constructor-arg value="climateBloatMonitor" />
        <constructor-arg ref="climateBloatMonitor" />
    </bean>

    <bean id="metarToClimatePurger"
        class="gov.noaa.nws.ocp.edex.metartoclimate.ClimateMetarPurger">
        <constructor-arg ref="climateMetarReportDAO" />
        <property name="purgeHours" value="48" />
    </bean>
    
    <bean id="metarToClimateSvr-camel" factory-bean="routeContextFactory" factory-method="createClustered">
        <constructor-arg>
            <bean class="gov.noaa.nws.ocp.edex.metartoclimate.MetarToClimateSvrCamelRoutes">
                <constructor-arg name="metartoclimatepurgeCron" value="${metartoclimatepurge.cron}" />
            </bean>
        </constructor-arg>
    </bean>
</beans>