<beans xmlns="http://www.springframework.org/schema/beans"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

    <bean id="climateCPGSessionPurger"
        class="gov.noaa.nws.ocp.edex.climate.prodgen.ClimateProdGenerateSessionPurger">
        <property name="retentionHours" value="72" />
    </bean>
    
    <bean id="climateSentRecordPurger"
        class="gov.noaa.nws.ocp.edex.climate.prodgen.SentClimateProductRecordPurger">
        <property name="retentionHours" value="168" />
    </bean>
    
    <bean id="cpg_purger-camel" factory-bean="routeContextFactory" factory-method="createClustered">
        <constructor-arg>
            <bean class="gov.noaa.nws.ocp.edex.climate.prodgen.CpgPurgerCamelRoutes">
                <constructor-arg name="cpgPurgerCron" value="${cpg.purger.cron}" />
                <constructor-arg name="recordPurgerCron" value="${record.purger.cron}" />
            </bean>
        </constructor-arg>
    </bean>
</beans>